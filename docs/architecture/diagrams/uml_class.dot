digraph class {
	bgcolor=white compound=true dpi=120 fontname=Helvetica nodesep=.3 overlap=false pad=.35 rankdir=LR ranksep=1.0 splines=spline
	node [fontname=Helvetica fontsize=11 shape=plain]
	edge [arrowsize=.7 color="#64748B" fontname=Helvetica fontsize=10 penwidth=1.3]
	subgraph cluster_Access {
		color="#CBD5E1" fontcolor="#334155" fontsize=18 label=Access labelloc=t margin=16 style=rounded
		UserAccount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>UserAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- role: TEXT<BR ALIGN="LEFT"/>- created_at: TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ canPerform(action: String): Boolean</TD></TR></TABLE>>]
	}
	subgraph cluster_Need_and_zone {
		color="#CBD5E1" fontcolor="#334155" fontsize=18 label="Need and zone" labelloc=t margin=16 style=rounded
		AidZone [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>AidZone</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- name: TEXT<BR ALIGN="LEFT"/>- latitude: NUMERIC(9,6)<BR ALIGN="LEFT"/>- longitude: NUMERIC(9,6)<BR ALIGN="LEFT"/>- disaster_type: TEXT<BR ALIGN="LEFT"/>- status: TEXT</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ deactivate(reason: String): void</TD></TR></TABLE>>]
		AidRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#7C3AED" STYLE="ROUNDED"><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>AidRequest</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- reporter_id: UUID[0..1] {FK}<BR ALIGN="LEFT"/>- zone_id: UUID[0..1] {FK}<BR ALIGN="LEFT"/>- review_status: TEXT<BR ALIGN="LEFT"/>- lifecycle_state: TEXT<BR ALIGN="LEFT"/>- latitude: NUMERIC(9,6)<BR ALIGN="LEFT"/>- longitude: NUMERIC(9,6)<BR ALIGN="LEFT"/>- contact_phone_encrypted: BYTEA[0..1]<BR ALIGN="LEFT"/>- urgency_score: NUMERIC(3,1)[0..1]<BR ALIGN="LEFT"/>- tracking_token_hash: TEXT[0..1]<BR ALIGN="LEFT"/>- submitted_at: TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ verify(): void<BR ALIGN="LEFT"/>+ archive(): void</TD></TR></TABLE>>]
		AidRequestLine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>AidRequestLine</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- request_id: UUID {FK}<BR ALIGN="LEFT"/>- category: TEXT<BR ALIGN="LEFT"/>- item_name: TEXT<BR ALIGN="LEFT"/>- quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- unit: TEXT</TD></TR></TABLE>>]
		AidNeed [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>AidNeed</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- zone_id: UUID {FK}<BR ALIGN="LEFT"/>- category: TEXT<BR ALIGN="LEFT"/>- item_name: TEXT<BR ALIGN="LEFT"/>- unit: TEXT<BR ALIGN="LEFT"/>- required_quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- reserved_quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- delivered_quantity: NUMERIC(14,2)</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ openDeficit(): Decimal</TD></TR></TABLE>>]
	}
	subgraph cluster_Dispatch {
		color="#CBD5E1" fontcolor="#334155" fontsize=18 label=Dispatch labelloc=t margin=16 style=rounded
		TimeSlot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>TimeSlot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- zone_id: UUID {FK}<BR ALIGN="LEFT"/>- starts_at: TIMESTAMPTZ<BR ALIGN="LEFT"/>- ends_at: TIMESTAMPTZ<BR ALIGN="LEFT"/>- max_vehicles: INTEGER<BR ALIGN="LEFT"/>- assigned_vehicles: INTEGER</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ hasCapacity(): Boolean</TD></TR></TABLE>>]
		Vehicle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>Vehicle</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- carrier_id: UUID {FK}<BR ALIGN="LEFT"/>- license_plate: TEXT<BR ALIGN="LEFT"/>- vehicle_type: TEXT<BR ALIGN="LEFT"/>- capacity_kg: NUMERIC(14,2)</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ isEligible(slot: TimeSlot): Boolean</TD></TR></TABLE>>]
		Shipment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>Shipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- carrier_id: UUID {FK}<BR ALIGN="LEFT"/>- vehicle_id: UUID {FK}<BR ALIGN="LEFT"/>- target_zone_id: UUID {FK}<BR ALIGN="LEFT"/>- time_slot_id: UUID {FK}<BR ALIGN="LEFT"/>- status: TEXT<BR ALIGN="LEFT"/>- created_at: TIMESTAMPTZ<BR ALIGN="LEFT"/>- updated_at: TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ depart(): void<BR ALIGN="LEFT"/>+ confirmHandover(): void</TD></TR></TABLE>>]
		ShipmentItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>ShipmentItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- shipment_id: UUID {FK}<BR ALIGN="LEFT"/>- aid_need_id: UUID {FK}<BR ALIGN="LEFT"/>- pledged_quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- actual_delivered_quantity: NUMERIC(14,2)[0..1]</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ reconcile(actual: Decimal): void</TD></TR></TABLE>>]
	}
	subgraph cluster_Warehouse {
		color="#CBD5E1" fontcolor="#334155" fontsize=18 label=Warehouse labelloc=t margin=16 style=rounded
		Warehouse [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#B45309" STYLE="ROUNDED"><TR><TD BGCOLOR="#FFF8E8" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>Warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- zone_id: UUID[0..1] {FK}<BR ALIGN="LEFT"/>- name: TEXT<BR ALIGN="LEFT"/>- latitude: NUMERIC(9,6)<BR ALIGN="LEFT"/>- longitude: NUMERIC(9,6)</TD></TR></TABLE>>]
		StockItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#B45309" STYLE="ROUNDED"><TR><TD BGCOLOR="#FFF8E8" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>StockItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- warehouse_id: UUID {FK}<BR ALIGN="LEFT"/>- category: TEXT<BR ALIGN="LEFT"/>- item_name: TEXT<BR ALIGN="LEFT"/>- unit: TEXT<BR ALIGN="LEFT"/>- on_hand_quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- reserved_quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- barcode: TEXT[0..1]<BR ALIGN="LEFT"/>- lot_number: TEXT[0..1]</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ availableQuantity(): Decimal</TD></TR></TABLE>>]
		StockReservation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#B45309" STYLE="ROUNDED"><TR><TD BGCOLOR="#FFF8E8" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>StockReservation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- stock_item_id: UUID {FK}<BR ALIGN="LEFT"/>- shipment_item_id: UUID {FK}<BR ALIGN="LEFT"/>- quantity: NUMERIC(14,2)<BR ALIGN="LEFT"/>- status: TEXT</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ release(): void</TD></TR></TABLE>>]
	}
	subgraph cluster_Governance {
		color="#CBD5E1" fontcolor="#334155" fontsize=18 label=Governance labelloc=t margin=16 style=rounded
		HandoverProof [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#7C3AED" STYLE="ROUNDED"><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>HandoverProof</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- shipment_id: UUID {FK}<BR ALIGN="LEFT"/>- verifier_user_id: UUID {FK}<BR ALIGN="LEFT"/>- proof_method: TEXT<BR ALIGN="LEFT"/>- proof_hash: TEXT<BR ALIGN="LEFT"/>- confirmed_at: TIMESTAMPTZ[0..1]<BR ALIGN="LEFT"/>- server_verified: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">+ validateProof(): Boolean</TD></TR></TABLE>>]
		AuditEntry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>AuditEntry</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- actor_id: UUID[0..1] {FK}<BR ALIGN="LEFT"/>- entity_type: TEXT<BR ALIGN="LEFT"/>- entity_id: UUID<BR ALIGN="LEFT"/>- action: TEXT<BR ALIGN="LEFT"/>- occurred_at: TIMESTAMPTZ<BR ALIGN="LEFT"/>- payload: JSONB</TD></TR></TABLE>>]
		IdempotencyRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white" COLOR="#1D4ED8" STYLE="ROUNDED"><TR><TD BGCOLOR="#F0F7FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="15"><B>IdempotencyRecord</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6">- id: UUID {PK}<BR ALIGN="LEFT"/>- actor_scope: TEXT<BR ALIGN="LEFT"/>- http_method: TEXT<BR ALIGN="LEFT"/>- path: TEXT<BR ALIGN="LEFT"/>- idempotency_key: TEXT<BR ALIGN="LEFT"/>- payload_hash: TEXT<BR ALIGN="LEFT"/>- result: JSONB<BR ALIGN="LEFT"/>- expires_at: TIMESTAMPTZ</TD></TR></TABLE>>]
	}
	UserAccount -> AidRequest [label="" constraint=true dir=none headlabel="0..*" taillabel="0..1"]
	AidZone -> AidRequest [label="" constraint=true dir=none headlabel="0..*" taillabel="0..1"]
	AidRequest -> AidRequestLine [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	AidZone -> AidNeed [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	AidZone -> TimeSlot [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	UserAccount -> Vehicle [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	UserAccount -> Shipment [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	Vehicle -> Shipment [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	AidZone -> Shipment [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	TimeSlot -> Shipment [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	Shipment -> ShipmentItem [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	AidNeed -> ShipmentItem [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	AidZone -> Warehouse [label="" constraint=true dir=none headlabel="0..*" taillabel="0..1"]
	Warehouse -> StockItem [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	StockItem -> StockReservation [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	ShipmentItem -> StockReservation [label="" constraint=true dir=none headlabel="0..*" taillabel=1]
	Shipment -> HandoverProof [label="" constraint=false dir=none headlabel="0..*" taillabel=1]
	UserAccount -> HandoverProof [label="" constraint=false dir=none headlabel="0..*" taillabel=1]
	UserAccount -> AuditEntry [label="" constraint=false dir=none headlabel="0..*" taillabel="0..1"]
}
